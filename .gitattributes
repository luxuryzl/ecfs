# 设置默认行为：所有文本文件自动处理，但在仓库中统一存储为 LF
* text=auto eol=lf

# 明确指定某些文件类型必须使用 LF（适用于代码、配置文件等）
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sh text eol=lf

# 明确指定 Windows 脚本使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不处理换行符
*.png binary
*.jpg binary
*.gif binary
*.exe binary